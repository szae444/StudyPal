rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Secure and organized path for user payment receipts
    match /receipts/{fileName} {
      // Allow read for authenticated users (users checking their proof, and admin reviewing it)
      allow read: if request.auth != null;
      
      // Allow create only if authenticated and the filename starts with their userId.
      // Firebase Storage matches() uses full-string RE2 — no ^ anchor needed.
      allow create: if request.auth != null && fileName.matches(request.auth.uid + '_.*');
      
      // Crucially, prevent update and delete to keep payment proofs secure and permanent
      allow update, delete: if false;
    }

    // Optional: Standard folder for individual user study files/documents if needed in future
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Default fallback rules for other folders
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
